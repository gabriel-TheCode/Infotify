<?xml version="1.0" encoding="utf-8"?>
<!--
    The Infotify mark: the "i" of the wordmark, with its dot detached.

    Geometry is taken from the Bricolage Grotesque "i" the wordmark is set in — a heavy,
    slightly narrowed stem with near-square terminals, and a dot wider than the stem, as
    heavy grotesques draw it. Icon and wordmark are therefore the same letter, not two
    drawings that happen to share an idea.

    Two decisions make it legible at 24dp, which the previous version was not:
      · the gap between dot and stem is 8.5 units — large enough to survive downscaling,
        so the detachment reads as intent rather than as a rendering artefact;
      · the dot is offset to the right of the stem axis. The asymmetry is what makes the
        silhouette memorable and stops it resolving into a generic info glyph.

    Everything sits inside the 66dp safe circle, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem, in paper. -->
    <path
        android:fillColor="#FBF8F5"
        android:pathData="M44,52 h14 a2.5,2.5 0 0 1 2.5,2.5 v25 a2.5,2.5 0 0 1 -2.5,2.5 h-14 a2.5,2.5 0 0 1 -2.5,-2.5 v-25 a2.5,2.5 0 0 1 2.5,-2.5 z" />

    <!-- Detached dot, in ember: the one element that carries the brand colour. -->
    <path
        android:fillColor="#FF6A1F"
        android:pathData="M60,34 m-9.5,0 a9.5,9.5 0 1 0 19,0 a9.5,9.5 0 1 0 -19,0 z" />
</vector>
