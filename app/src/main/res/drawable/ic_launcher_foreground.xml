<?xml version="1.0" encoding="utf-8"?>
<!--
    Infotify mark: the stem of an "i" whose dot has lifted away as a notification pip.

    Drawn on the standard 108dp adaptive canvas; everything sits inside the 66dp safe
    circle so no launcher mask clips it. It reads as a single silhouette at 24dp, which
    is what the previous newspaper glyph could not do.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem of the i -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48.5,48 h11 a3,3 0 0 1 3,3 v25 a3,3 0 0 1 -3,3 h-11 a3,3 0 0 1 -3,-3 v-25 a3,3 0 0 1 3,-3 z" />

    <!-- Detached dot, offset up and to the right: the notification -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62,30 m-9,0 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 z" />

    <!-- Motion trace linking stem to dot, tapering as it rises -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45"
        android:pathData="M46,42 l6,-4 l3,5 l-6,4 z" />
</vector>
